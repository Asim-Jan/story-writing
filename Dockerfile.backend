FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files + frontend sources (vite/tailwind are devDependencies,
# so the build needs the full dependency tree — pruned after the build)
COPY package*.json ./
COPY server/package*.json ./server/
COPY src ./src
COPY public ./public
COPY index.html ./
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

RUN npm install
RUN cd server && npm install --production

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ── runtime ────────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Runtime dependencies only (backend)
COPY package*.json ./
COPY server/package*.json ./server/
RUN npm install --production
RUN cd server && npm install --production

COPY server ./server
# No .env* copy: config comes from the ConfigMap/Secrets, and this image is pushed to a registry.

# The built frontend rides in the SAME image — the backend serves it and
# there is no nginx deployment (SAI-Cloud shape: one server for app + API)
COPY --from=builder /app/dist ./public/dist

EXPOSE 3001

CMD ["node", "server/index.js"]
