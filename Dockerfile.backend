FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY server/package*.json ./server/

# Install dependencies
RUN npm install --production
RUN cd server && npm install --production

# Copy application files
COPY server ./server
COPY .env* ./

# Expose port
EXPOSE 3001

# Start the server
CMD ["node", "server/index.js"]
