# Server Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
PORT=3002
NODE_ENV=development

# Frontend/Client Configuration
VITE_API_URL=http://localhost:3002
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3002

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=16384
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret (generate a random string for production)
SESSION_SECRET=your_random_session_secret_here

# Storage Configuration - Choose ONE:
# Option 1: AWS S3 (for production on AWS)
AWS_S3_BUCKET=story-writing-uploads
AWS_REGION=eu-west-2
# AWS credentials (optional if using IAM roles in ECS)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Option 2: MinIO (for local development or self-hosted)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_IMAGES=story-images
MINIO_BUCKET_AUDIO=story-audio
MINIO_BUCKET_COMICS=story-comics
MINIO_BUCKET_VIDEOS=story-videos
