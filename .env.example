# Server Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
PORT=3002
NODE_ENV=development

# Frontend/Client Configuration
VITE_API_URL=http://localhost:3002
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3002

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=16384
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret (generate a random string for production)
SESSION_SECRET=your_random_session_secret_here

# Encryption Key for sensitive data (API keys, etc.)
# Generate a strong random string (32+ characters)
# If not set, falls back to SESSION_SECRET
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Media storage: SAI Drive's app API (the ONLY media store; there is no MinIO or S3 any more).
# Locally, run the fake (`npm run dev:drive`, or `docker-compose up -d fake-drive`) and keep these;
# in the cluster the secret comes from story-writing-secrets (key drive-app). No Drive = media routes 503.
DRIVE_APP_API_URL=http://127.0.0.1:8150
DRIVE_APP_API_SECRET=drive-test-secret-0123456789abcdef0123456789abcdef
DRIVE_CARETAKER_SUB=u_0000000000000001
